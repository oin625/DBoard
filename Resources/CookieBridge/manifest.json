{
  "manifest_version": 3,
  "name": "DBoard Cookie Bridge",
  "version": "2.5",
  "description": "把 Reqflow 和 Audi 登录态投递给本机 DBoard 看板（仅访问 127.0.0.1，不联网）",
  "permissions": ["cookies", "alarms", "tabs", "downloads"],
  "host_permissions": ["*://*.tmallyc.com/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "DBoard Cookie Bridge" }
}
